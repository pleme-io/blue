use("moji", [:includes, :is_blank, :lines, :squish, :strip_prefix])

use(
  "retsu",
  [:concat_lists, :drop_while, :first, :flat_map, :last, :rest, :take_while]
)

# Writes docs/EXAMPLES.md, one file an agent or a person can paste as
# examples, from the golden corpus in examples/. Declared in the root
# Bluefile with generate(), whose inputs name examples/: in nix the directory
# is under $GEN_ROOT, and under `nix run .#regen` it is ./examples. Every
# example also runs as a check, so what this file shows is what passes.
#
# Each example opens with a comment block: its first line is the title and
# the rest is the prose. A bidama under examples/bidamas is shown in full just
# before the first example that uses it.

def examples_dir()
  path_join(getenv("GEN_ROOT", "."), "examples")
end

def comment?(line)
  starts_with?(line, "#")
end

def uncomment(line)
  strip_prefix(strip_prefix(line, "#"), " ")
end

# [title, prose lines, code] for one example's text. A script's shebang line
# is not its title: it stays at the top of the code.
def split_example(text)
  all = lines(text)
  bang = filter(fn(l) starts_with?(l, "#!") end, take(1, all))
  body = drop(length(bang), all)
  head = take_while(fn(l) comment?(l) end, body)
  code = drop_while(fn(l) l == "" end, drop_while(fn(l) comment?(l) end, body))
  [
    uncomment(first(head)),
    map(fn(l) uncomment(l) end, rest(head)),
    join(concat_lists(bang, code), "\n")
  ]
end

def prose_lines(prose)
  paras = split(join(prose, "\n"), "\n\n")
  map(fn(p) squish(p) end, filter(fn(p) not is_blank(p) end, paras))
end

def fenced(lang, text)
  "```#{lang}\n#{trim(text)}\n```"
end

def files()
  filter(fn(p) ends_with?(p, ".b") end, ls(examples_dir))
end

def packages()
  root = path_join(examples_dir, "bidamas")
  if is_dir?(root)
    filter(fn(p) is_file?(path_join(p, "Bluefile")) end, ls(root))
  else
    []
  end
end

def uses?(text, pkg)
  includes(text, "use(\"#{pkg}\")")
end

def package_section(dir)
  name = path_basename(dir)
  source = read_file(path_join(dir, "#{name}.b"))
  gloss = uncomment(first(lines(source)))
  [
    "## A bidama: `#{name}`",
    gloss,
    "`examples/bidamas/#{name}/Bluefile`:",
    fenced("blue", read_file(path_join(dir, "Bluefile"))),
    "`examples/bidamas/#{name}/#{name}.b`:",
    fenced("blue", source)
  ]
end

def example_section(path)
  parts = split_example(read_file(path))
  concat_lists(
    concat_lists(["## #{first(parts)}"], prose_lines(nth(1, parts))),
    ["`examples/#{path_basename(path)}`:", fenced("blue", last(parts))]
  )
end

# The sections in order: each example, preceded by any bidama it is the first
# to use.
def example_sections()
  step = reduce(
    fn(acc, path)
      text = read_file(path)
      pending = first(acc)
      now = filter(fn(d) uses?(text, path_basename(d)) end, pending)
      later = filter(fn(d) not member?(d, now) end, pending)
      shown = flat_map(fn(d) package_section(d) end, now)
      [
        later,
        concat_lists(last(acc), concat_lists(shown, example_section(path)))
      ]
    end,
    [packages, []],
    files
  )
  concat_lists(last(step), flat_map(fn(d) package_section(d) end, first(step)))
end

def render()
  header = [
    "# blue examples",
    "Generated by `gen/examples.b` from [`examples/`](../examples). Do not edit by hand: run `nix run .#regen`, and the `generated-examples-fresh` check fails when this file is stale.",
    "Each program is one blessed way to do a common task, and each runs as a check (`checks.examples`), so every line below is known to work. The names each one calls are in [`REFERENCE.md`](REFERENCE.md) and [`../bidamas/CATALOG.md`](../bidamas/CATALOG.md)."
  ]
  "#{join(concat_lists(header, example_sections), "\n\n")}\n"
end

write_file(getenv("GEN_OUT", "docs/EXAMPLES.md"), render)
nil
