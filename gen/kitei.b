use("kitei", [:rules])
use("tesuto", [:skip_for])

@doc """
row_of: one shipped rule as the Rust tuple the runtime reads: its id, the facts it needs and its switch, one part a line when the tuple passes 60 columns, as rustfmt writes it.

    row_of(kitei::named("R2")) #=> "    (\"R2\", &[\"pure\", \"self_overlapping\"], \"BLUE_MEMO=off\"),"
    contains?(row_of(kitei::named("R15")), "        \"R15\",") #=> true
"""
def row_of(r)
  needs = join(map((f) -> "\"#{to_s(f)}\"", r.needs), ", ")
  parts = ["\"#{r.id}\"", "&[#{needs}]", "\"#{r.switch}\""]
  inner = join(parts, ", ")
  if length(inner) > 60
    join(
      append(["    ("], append(map((p) -> "        #{p},", parts), ["    ),"])),
      line_break
    )
  else
    "    (#{inner}),"
  end
end

@doc """
rendered: the Rust table of every shipped rule in `all`, in the registry's order.

    contains?(rendered(rules), "(\"R10\", &[\"member_test\"], \"BLUE_INDEX=off\"),") #=> true
"""
def rendered(all)
  rows = map(row_of, filter((r) -> r.state == :shipped, all))
  head = [
    "// @generated by gen/kitei.b from bidamas/kitei. Do not edit: regenerate from the source.",
    "",
    "pub const RULES: &[(&str, &[&str], &str)] = &["
  ]
  unlines(append(append(head, rows), ["];"]))
end

def main()
  write_file(
    getenv("GEN_OUT", "crates/blue-lang-runtime/src/kitei/tables.rs"),
    rendered(rules)
  )
end

test "the table holds every shipped rule and no other"
  text = rendered(rules)
  assert contains?(
    text,
    "(\"R4\", &[\"pure\", \"literal_call\"], \"BLUE_FOLD=off\"),"
  )
  assert not contains?(text, "\"R6\"")
  assert not contains?(text, "\"R11\"")
end

test "no rule is an empty table"
  assert ends_with?(rendered([]), unlines(["&[", "];"]))
end

test "rustc reads the rendered table back as the registry", {kind: :rendering}
  found = exec_capture("rustc", "--version") rescue nil
  skip_for(
    if found.nil?
      "rustc is not on PATH, and it is the reader of the rendered table"
    end
  )
  dir = temp_dir("kitei-table")
  write_file(path_join(dir, "tables.rs"), rendered(rules))
  write_file(
    path_join(dir, "main.rs"),
    unlines(
      [
        "mod tables;",
        "fn main() {",
        "    for (id, needs, switch) in tables::RULES {",
        "        println!(\"{id} {} {switch}\", needs.join(\",\"));",
        "    }",
        "}"
      ]
    )
  )
  bin = path_join(dir, "rules")
  built = exec_capture(
    "rustc",
    "--edition",
    "2021",
    "-o",
    bin,
    path_join(dir, "main.rs")
  )
  assert built.status == 0
  ran = exec_capture(bin)
  want = map(
    (r) -> "#{r.id} #{join(map(to_s, r.needs), ",")} #{r.switch}",
    filter((r) -> r.state == :shipped, rules)
  )
  assert ran.stdout == unlines(want)
end
