[
  {
    "name": "short hex",
    "file": "gamen.b",
    "find": "retsu::size(chars(digits)) == 3",
    "replace": "retsu::size(chars(digits)) == 4"
  },
  {
    "name": "hex prefix required",
    "file": "gamen.b",
    "find": "if text == digits or",
    "replace": "if"
  },
  {
    "name": "hex length",
    "file": "gamen.b",
    "find": "retsu::size(chars(full)) != 6 or",
    "replace": ""
  },
  {
    "name": "hex digits",
    "file": "gamen.b",
    "find": "count_where(number?, values) != 3",
    "replace": "false"
  },
  {
    "name": "hex base",
    "file": "gamen.b",
    "find": "\"\"), 16)",
    "replace": "\"\"), 10)"
  },
  {
    "name": "record range high",
    "file": "gamen.b",
    "find": "v >= 0 and v <= 255",
    "replace": "v >= 0"
  },
  {
    "name": "record range low",
    "file": "gamen.b",
    "find": "v >= 0 and v <= 255",
    "replace": "v <= 255"
  },
  {
    "name": "record count",
    "file": "gamen.b",
    "find": "v <= 255, parts) != 3",
    "replace": "v <= 255, parts) != 2"
  },
  {
    "name": "hex pad",
    "file": "gamen.b",
    "find": "to_hex_width(round(get(c, :g)), 2)",
    "replace": "to_hex(round(get(c, :g)))"
  },
  {
    "name": "linear threshold",
    "file": "gamen.b",
    "find": "c <= 0.03928",
    "replace": "c <= 0.5"
  },
  {
    "name": "linear exponent",
    "file": "gamen.b",
    "find": "exp(2.4 * log",
    "replace": "exp(2.2 * log"
  },
  {
    "name": "luminance weights",
    "file": "gamen.b",
    "find": "0.2126 * linear",
    "replace": "0.3 * linear"
  },
  {
    "name": "luminance green",
    "file": "gamen.b",
    "find": "0.7152 * linear",
    "replace": "0.5 * linear"
  },
  {
    "name": "luminance blue",
    "file": "gamen.b",
    "find": "0.0722 * linear",
    "replace": "0.2 * linear"
  },
  {
    "name": "contrast order",
    "file": "gamen.b",
    "find": "(blue::max(la, lb) + 0.05) / (blue::min(la, lb) + 0.05)",
    "replace": "(la + 0.05) / (lb + 0.05)"
  },
  {
    "name": "contrast offset",
    "file": "gamen.b",
    "find": "(blue::max(la, lb) + 0.05)",
    "replace": "(blue::max(la, lb) + 0.1)"
  },
  {
    "name": "theme modes",
    "file": "gamen.b",
    "find": "[:light, :dark]",
    "replace": "[:light, :dark, :sepia]"
  },
  {
    "name": "theme pair",
    "file": "gamen.b",
    "find": "get(value, mode)",
    "replace": "get(value, :light)"
  },
  {
    "name": "theme error naming",
    "file": "gamen.b",
    "find": "raise(:bad_option, \"token #{to_s(name)}: #{e.message}\")",
    "replace": "raise(:bad_option, e.message)"
  },
  {
    "name": "theme non-picked",
    "file": "gamen.b",
    "find": "  hex(picked)\n",
    "replace": "  picked\n"
  },
  {
    "name": "token missing",
    "file": "gamen.b",
    "find": "  if found.nil?\n    raise(:bad_option, \"no theme token",
    "replace": "  if false\n    raise(:bad_option, \"no theme token"
  },
  {
    "name": "paint token",
    "file": "gamen.b",
    "find": "if string?(value) or map?(value)",
    "replace": "if string?(value)"
  },
  {
    "name": "sgr fg",
    "file": "gamen.b",
    "find": "sequence(\"38\", get(node, :fg), theme)",
    "replace": "sequence(\"48\", get(node, :fg), theme)"
  },
  {
    "name": "sgr bg",
    "file": "gamen.b",
    "find": "sequence(\"48\", get(node, :bg), theme)",
    "replace": "sequence(\"38\", get(node, :bg), theme)"
  },
  {
    "name": "sgr bold",
    "file": "gamen.b",
    "find": "[:bold, \"1\"]",
    "replace": "[:bold, \"3\"]"
  },
  {
    "name": "sgr dim",
    "file": "gamen.b",
    "find": "[:dim, \"2\"]",
    "replace": "[:dim, \"5\"]"
  },
  {
    "name": "sgr underline",
    "file": "gamen.b",
    "find": "[:underline, \"4\"]",
    "replace": "[:underline, \"7\"]"
  },
  {
    "name": "flag false",
    "file": "gamen.b",
    "find": "get(node, first(p)) == true",
    "replace": "get(node, first(p)) != nil"
  },
  {
    "name": "reset",
    "file": "gamen.b",
    "find": "#{get(node, :text)}#{esc_char}[0m",
    "replace": "#{get(node, :text)}#{esc_char}[m"
  },
  {
    "name": "color off",
    "file": "gamen.b",
    "find": "if is_empty(on) or not get(ctx, :color)",
    "replace": "if is_empty(on)"
  },
  {
    "name": "plain map",
    "file": "gamen.b",
    "find": "if is_empty(on) or not get(ctx, :color)",
    "replace": "if not get(ctx, :color)"
  },
  {
    "name": "list join",
    "file": "gamen.b",
    "find": "join(map((n) -> styled(n, ctx), node), \"\")",
    "replace": "join(map((n) -> styled(n, ctx), node), \" \")"
  },
  {
    "name": "node text",
    "file": "gamen.b",
    "find": "elsif map?(node) and string?(get(node, :text))",
    "replace": "elsif map?(node)"
  },
  {
    "name": "no color env",
    "file": "gamen.b",
    "find": "no_color.nil? or no_color == \"\"",
    "replace": "no_color.nil?"
  },
  {
    "name": "sink wins",
    "file": "gamen.b",
    "find": "  if sink != nil\n    sink",
    "replace": "  if false\n    sink"
  },
  {
    "name": "to stderr",
    "file": "gamen.b",
    "find": "elsif to == :stderr",
    "replace": "elsif to == :stdout"
  },
  {
    "name": "show checked",
    "file": "gamen.b",
    "find": "  checked(opts, [:theme, :color, :sink, :to, :newline])\n",
    "replace": ""
  },
  {
    "name": "show newline",
    "file": "gamen.b",
    "find": "if get(opts, :newline) == false",
    "replace": "if get(opts, :newline) != false"
  },
  {
    "name": "show returns",
    "file": "gamen.b",
    "find": "  end\n  nil\nend\n\ndef close?",
    "replace": "  end\n  text\nend\n\ndef close?"
  },
  {
    "name": "show theme",
    "file": "gamen.b",
    "find": "theme: get(opts, :theme)",
    "replace": "theme: nil"
  },
  {
    "name": "stderr writer",
    "file": "gamen.b",
    "find": "(text) -> write_stderr(text)",
    "replace": "(text) -> write_stdout(text)"
  }
]
