[
  {
    "name": "folded lines join without a space",
    "file": "deeta.b",
    "find": "[\"#{out} #{l}\", l, 0]",
    "replace": "[\"#{out}#{l}\", l, 0]"
  },
  {
    "name": "clip chomping drops the final line break",
    "file": "deeta.b",
    "find": "  elsif has_body\n    unlines([text])\n",
    "replace": "  elsif has_body\n    text\n"
  },
  {
    "name": "true reads as false",
    "file": "deeta.b",
    "find": "if member?(t, true_words)\n    true",
    "replace": "if member?(t, true_words)\n    false"
  },
  {
    "name": "a double-quoted scalar loses its trailing blanks",
    "file": "deeta.b",
    "find": "    {text: \"#{out}#{ws}\", r:, c: c + 1}\n  elsif not double",
    "replace": "    {text: out, r:, c: c + 1}\n  elsif not double"
  },
  {
    "name": "a repeated key is refused for the wrong reason",
    "file": "deeta.b",
    "find": "          :duplicate_key,",
    "replace": "          :parse_error,"
  },
  {
    "name": "one document reads as a stream of documents",
    "file": "deeta.b",
    "find": "elsif count(docs) == 1",
    "replace": "elsif count(docs) == 2"
  },
  {
    "name": "an anchor names nothing",
    "file": "deeta.b",
    "find": "assoc(second(out), name, [first(out)])",
    "replace": "second(out)"
  },
  {
    "name": "a flow sequence key may end on the next line",
    "file": "deeta.b",
    "find": "  same_line = explicit or not in_seq or r2 == k[:r]\n",
    "replace": "  same_line = explicit or not in_seq or true\n"
  },
  {
    "name": "an octal integer reads as text",
    "file": "deeta.b",
    "find": "if starts_with?(t, \"0o\") and",
    "replace": "if starts_with?(t, \"0q\") and"
  },
  {
    "name": "toml writes a null",
    "file": "deeta.b",
    "find": "raise(:render_error, \"TOML has no null: #{name}\")",
    "replace": "\"null\""
  },
  {
    "name": "toml keeps an absent value",
    "file": "deeta.b",
    "find": "live = filter((e) -> not second(e).nil?, map_entries(m))",
    "replace": "live = map_entries(m)"
  },
  {
    "name": "toml takes a list at the top",
    "file": "deeta.b",
    "find": "  if not map?(v)\n    raise(:render_error, \"TOML's top level",
    "replace": "  if false\n    raise(:render_error, \"TOML's top level"
  },
  {
    "name": "toml writes a nested table's path as its leaf",
    "file": "deeta.b",
    "find": "toml_section(live, path, \"[#{join(path, \".\")}]\")",
    "replace": "toml_section(live, path, \"[#{nth(0, reverse(path))}]\")"
  }
]
