[
  {
    "name": "flag text keeps underscores",
    "file": "hikisuu.b",
    "find": "\"--#{replace(to_s(key), \"_\", \"-\")}\"",
    "replace": "\"--#{to_s(key)}\""
  },
  {
    "name": "an integer default reads as text",
    "file": "hikisuu.b",
    "find": "elsif integer?(default)",
    "replace": "elsif false"
  },
  {
    "name": "the floor admits one less",
    "file": "hikisuu.b",
    "find": "n < get(f, :min)",
    "replace": "n < get(f, :min) - 1"
  },
  {
    "name": "-- does not end the flags",
    "file": "hikisuu.b",
    "find": "    if arg == \"--\"\n",
    "replace": "    if arg == \"-- \"\n"
  },
  {
    "name": "a switch takes the next word",
    "file": "hikisuu.b",
    "find": "      elsif get(f, :kind) == :switch\n",
    "replace": "      elsif false\n"
  },
  {
    "name": "--help is not help",
    "file": "hikisuu.b",
    "find": "member?(\"-h\", before) or member?(\"--help\", before)",
    "replace": "member?(\"-h\", before)"
  },
  {
    "name": "a short unknown flag passes as a word",
    "file": "hikisuu.b",
    "find": "elsif starts_with?(arg, \"-\") and arg != \"-\"",
    "replace": "elsif false"
  },
  {
    "name": "a many positional takes one word",
    "file": "hikisuu.b",
    "find": "    if get(s, :many)\n      place([], rest(slots)",
    "replace": "    if false\n      place([], rest(slots)"
  },
  {
    "name": "an optional positional is required",
    "file": "hikisuu.b",
    "find": "      if get(s, :optional)\n",
    "replace": "      if false\n"
  },
  {
    "name": "a value flag still completes flags",
    "file": "hikisuu.b",
    "find": "    if valued != nil\n",
    "replace": "    if false\n"
  },
  {
    "name": "completion is unsorted",
    "file": "hikisuu.b",
    "find": "sort_keyed((w) -> w, filter((w) -> starts_with?(w, typed), candidates))",
    "replace": "filter((w) -> starts_with?(w, typed), candidates)"
  },
  {
    "name": "a usage refusal exits 1",
    "file": "hikisuu.b",
    "find": "status: exit_status(:usage),",
    "replace": "status: 1,"
  }
]
