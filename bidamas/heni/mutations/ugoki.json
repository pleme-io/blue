[
  {
    "name": "ease clamp low",
    "file": "ugoki.b",
    "find": "u = clamp(t, 0, 1)",
    "replace": "u = min(t, 1)"
  },
  {
    "name": "ease clamp high",
    "file": "ugoki.b",
    "find": "u = clamp(t, 0, 1)",
    "replace": "u = max(t, 0)"
  },
  {
