@moduledoc """
core-models: every blue program in this repository that declares a core model, and the two renderings checked over all of them: docs/SETTINGS.md (the settings table of each, generated, gated fresh) and the check that no program reads a setting its model lacks.

    size(programs) >= 1 #=> true
"""

# waive B0085: rendering debt recorded 2026-11-13: no test of this generator declared kind: :rendering feeds its output to the output's reader yet
use("deeta")
use("heni")
use("jisho", [:from_entries])
use("kakehashi")
use("retsu", %i[flat_map size])
use("settei")
use("shisutemu", %i[status_of stderr_of stdout_of])

@doc """
programs: each program with a core model: its app name, source file, settings, command-line frame and the parameter its code reads the settings off.

    retsu::first(programs)[:app] #=> "souji"
"""
def programs()
  [
    {
      app: "souji",
      file: "bidamas/kakehashi/souji/souji.b",
      settings: kakehashi::souji::settings,
      frame: kakehashi::souji::frame,
      param: "opts"
    },
    {
      app: "heni",
      file: "bidamas/heni/heni.b",
      settings: heni::settings,
      frame: heni::frame,
      param: "a"
    },
    {
      app: "kirikae",
      file: "bidamas/kakehashi/kirikae/kirikae.b",
      settings: kakehashi::kirikae::config_model,
      frame: {
        name: "kirikae",
        about: "switching over: whether a system switch must run, may be skipped, or must wait"
      },
      param: "config",
      door: :settled
    },
    {
      app: "kijun",
      file: "bidamas/kakehashi/kijun/kijun.b",
      settings: kakehashi::kijun::settings,
      frame: kakehashi::kijun::frame,
      param: "line_opts"
    },
    {
      app: "tehai",
      file: "bidamas/kakehashi/tehai/tehai.b",
      settings: kakehashi::tehai::config_model,
      frame: {
        name: "tehai",
        about: "the nix builders and substituters that answer: each declared one probed, and the live files written from those that did"
      },
      param: "config",
      door: :settled
    }
  ]
end

@doc """
schemas: the JSON Schema of every program's settings, by app: the config file's schema, the chart values' schema and the MCP tool's input.

    retsu::first(map_entries(schemas))[0] #=> "heni"
"""
def schemas()
  from_entries(
    map((p) -> [p[:app], settei::json_schema(p[:app], p[:settings])], programs)
  )
end

def root()
  getenv("GEN_ROOT", ".")
end

@doc """
section: one program's part of the settings page: its heading, where its settings come from and its table.

    contains?(section(retsu::first(programs)), "## souji") #=> true
"""
def section(p)
  prefix = settei::env_prefix(p[:app])
  door = if p[:door] == :settled
    "then the environment. A bad value is refused for its key alone and warned on stderr."
  else
    "the `#{prefix}` environment, then the flags. `#{p[:app]} --explain KEY` shows one setting and the layer it came from."
  end
  unlines(
    [
      "## #{p[:app]}",
      "",
      "#{p[:frame][:about]}. Layers, lowest first: the defaults, `~/.config/#{p[:app]}/#{p[:app]}.yaml` (or the file `#{prefix}CONFIG` names), #{door}",
      "",
      settei::table(p[:app], p[:settings], {flags: p[:door] != :settled})
    ]
  )
end

@doc """
page: docs/SETTINGS.md, every program's section under one front matter.

    starts_with?(page, "---") #=> true
"""
def page()
  concat(
    unlines(
      [
        "---",
        "kind: reference",
        "summary: every setting of each blue program with a core model, rendered from the model by settei (generated)",
        "---",
        "",
        "# Settings",
        "",
        "Generated by `gen/core-models.b` from each program's core model (docs/CORE-MODEL.md). Do not edit this file; change the model and run `nix run .#regen`.",
        ""
      ]
    ),
    join(map(section, programs), line_break)
  )
end

@doc """
forms_of: the resolved forms of a blue file, as `blue ast --resolved` prints them.

    procedure?(forms_of) #=> true
"""
def forms_of(file)
  r = exec_capture(self_exe, "ast", "--resolved", file)
  if status_of(r) != 0
    raise(:refused, "blue ast --resolved #{file}: #{stderr_of(r)}")
  end
  read_forms(stdout_of(r))
end

@doc """
unmodelled_reads: for each program, each key its code reads off its settings that its core model and frame lack, as "app: key".

    procedure?(() -> unmodelled_reads) #=> true
"""
def unmodelled_reads()
  flat_map(
    programs,
    fn(p)
      forms = forms_of(path_join(root, p[:file]))
      map(
        (k) -> "#{p[:app]}: #{k}",
        settei::unmodelled(p[:settings], p[:frame], forms, p[:param])
      )
    end
  )
end

out = getenv("GEN_OUT")

if out != nil and ends_with?(out, ".json")
  write_file(out, deeta::pretty(schemas))
elsif out != nil
  write_file(out, page)
end

test "every program's knobs keep their bounds law on every layer"
  broken = flat_map(
    programs,
    fn(p)
      map((b) -> "#{p[:app]}: #{b}", settei::bounds_law(p[:app], p[:settings]))
    end
  )
  assert broken == []
end

test "every program's schema is the one its MCP tool takes"
  map(
    fn(p)
      assert settei::mcp_tool(p[:app], p[:settings])["inputSchema"] ==
        get(schemas, p[:app])
    end,
    programs
  )
  assert size(map_entries(schemas)) == size(programs)
end

test "no program reads a setting its core model lacks"
  found = unmodelled_reads
  if found != []
    write_stderr(
      unlines(
        map(
          (k) -> "#{k} is read in code and missing from the core model",
          found
        )
      )
    )
  end
  assert found == []
end

test "every program's knobs are all read by its code"
  unread = flat_map(
    programs,
    fn(p)
      forms = forms_of(path_join(root, p[:file]))
      map(
        (k) -> "#{p[:app]}: #{k}",
        settei::unread(p[:settings], forms, p[:param])
      )
    end
  )
  assert unread == []
end

test "the page holds a section and a row for every knob of every program"
  text = page
  assert size(programs) >= 1
  assert contains?(text, "## souji")
  assert contains?(text, "| `min_age_hours` | int | `6` | 0 or more | hours |")
end
