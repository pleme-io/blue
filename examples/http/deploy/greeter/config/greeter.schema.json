{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "flags": {
      "additionalProperties": false,
      "properties": {
        "shout": {
          "default": false,
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "greeting": {
      "default": "hello",
      "type": "string"
    },
    "health": {
      "default": "/healthz",
      "type": "string"
    },
    "listen": {
      "additionalProperties": false,
      "properties": {
        "host": {
          "default": "0.0.0.0",
          "type": "string"
        },
        "port": {
          "default": 18080,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "subject": {
      "default": "world",
      "type": "string"
    }
  },
  "title": "greeter settings",
  "type": "object"
}
