    "file": "gamen.b",
    "find": "[:dim, \"2\"]",
    "replace": "[:dim, \"5\"]"
  },
  {
    "name": "sgr underline",
    "file": "gamen.b",
    "find": "[:underline, \"4\"]",
    "replace": "[:underline, \"7\"]"
  },
  {
