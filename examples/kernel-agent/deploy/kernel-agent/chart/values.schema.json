{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "access": {
      "additionalProperties": false,
      "properties": {
        "effects": {
          "items": {
            "default": "network",
            "type": "string"
          },
          "type": "array"
        },
        "egress": {
          "type": "array"
        },
        "exec": {
          "type": "array"
        },
        "listen": {
          "items": {
            "default": 18081,
            "type": "integer"
          },
          "type": "array"
        },
        "reads": {
          "type": "array"
        },
        "writes": {
          "type": "array"
        }
      },
      "type": "object"
    },
    "args": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "command": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "config": {
      "additionalProperties": false,
      "properties": {},
      "type": "object"
    },
    "flags": {
      "additionalProperties": false,
      "properties": {},
      "type": "object"
    },
    "global": {
      "type": "object"
    },
    "health": {
      "default": "/healthz",
      "type": "string"
    },
    "image": {
      "additionalProperties": false,
      "properties": {
        "pullPolicy": {
          "default": "IfNotPresent",
          "type": "string"
        },
        "repository": {
          "default": "ghcr.io/pleme-io/blue",
          "type": "string"
        },
        "tag": {
          "default": "",
          "type": "string"
        }
      },
      "type": "object"
    },
    "listen": {
      "additionalProperties": false,
      "properties": {
        "host": {
          "default": "0.0.0.0",
          "type": "string"
        },
        "port": {
          "default": 18081,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "pleme-lib": {
      "type": "object"
    },
    "podAnnotations": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "podSecurityContext": {
      "const": {
        "runAsGroup": 0,
        "runAsNonRoot": false,
        "runAsUser": 0
      }
    },
    "resources": {
      "additionalProperties": false,
      "properties": {
        "limits": {
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          },
          "type": "object"
        },
        "requests": {
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "runtime": {
      "additionalProperties": false,
      "properties": {
        "class": {
          "default": "wasm",
          "type": "string"
        },
        "component": {
          "additionalProperties": false,
          "properties": {
            "app": {
              "default": "",
              "type": "string"
            },
            "closure": {
              "default": "",
              "type": "string"
            },
            "path": {
              "default": "component.wasm",
              "type": "string"
            }
          },
          "type": "object"
        },
        "kind": {
          "default": "native",
          "type": "string"
        },
        "reason": {
          "default": "device",
          "type": "string"
        }
      },
      "type": "object"
    },
    "securityContext": {
      "const": {
        "allowPrivilegeEscalation": false,
        "capabilities": {
          "add": [
            "BPF",
            "PERFMON",
            "NET_ADMIN"
          ],
          "drop": [
            "ALL"
          ]
        },
        "readOnlyRootFilesystem": true
      }
    },
    "service": {
      "additionalProperties": false,
      "properties": {
        "ports": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "default": "http",
                "type": "string"
              },
              "port": {
                "default": 18081,
                "type": "integer"
              },
              "protocol": {
                "default": "TCP",
                "type": "string"
              },
              "targetPort": {
                "default": "http",
                "type": "string"
              }
            },
            "type": "object"
          },
          "type": "array"
        },
        "type": {
          "default": "ClusterIP",
          "type": "string"
        }
      },
      "type": "object"
    },
    "serviceAccount": {
      "additionalProperties": false,
      "properties": {
        "automountServiceAccountToken": {
          "default": false,
          "type": "boolean"
        },
        "create": {
          "default": true,
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "slo": {
      "additionalProperties": false,
      "properties": {
        "dashboard": {
          "default": true,
          "type": "boolean"
        },
        "rules": {
          "default": true,
          "type": "boolean"
        }
      },
      "type": "object"
    }
  },
  "title": "kernel-agent chart values",
  "type": "object"
}
