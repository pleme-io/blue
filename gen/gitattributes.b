use("hon", [:generated_files])
use("junjo", [:sort])

@doc """
attribute_lines: The lines of `.gitattributes`: every generated file merges by
regenerating, and a ledger only ever gains lines.

    attribute_lines(["b.md", "a.md"])[3] #=> "Bluefile.lock merge=blue-generated"
    attribute_lines(["b.md", "a.md"])[5] #=> "/a.md merge=blue-generated"
    attribute_lines([])[4] #=> "/bidamas/NAMES.md merge=union"
"""
def attribute_lines(files)
  append(
    [
      "# Generated by gen/gitattributes.b from Bluefile.lock. Do not edit by hand: nix run .#regen.",
      "# merge=blue-generated regenerates the file from the merged tree (gen/merge.b).",
      "# nix develop sets the driver; a clone without it merges these as text.",
      "Bluefile.lock merge=blue-generated",
      "/bidamas/NAMES.md merge=union"
    ],
    map((p) -> "/#{p} merge=blue-generated", sort(files))
  )
end

def main()
  lock = path_join(getenv("GEN_ROOT", "."), "Bluefile.lock")
  manifest = json_read(read_file(lock))["manifest"]
  write_file(
    getenv("GEN_OUT", ".gitattributes"),
    unlines(attribute_lines(generated_files({manifest:})))
  )
end
