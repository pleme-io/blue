    "replace": "\"\""
  },
  {
    "name": "refusal scoped to the page by default",
    "file": "gamen.b",
    "find": "refuse = get(o, :refuse) or :node",
    "replace": "refuse = get(o, :refuse) or :page"
  },
  {
    "name": "page refusal off",
