    "name": "script tag in the table",
    "file": "gamen.b",
    "find": "tag_row(:div, false, []),",
    "replace": "tag_row(:div, false, []),\n    tag_row(:script, false, []),"
  },
  {
    "name": "onclick in the table",
    "file": "gamen.b",
    "find": "attr_row(:id, \"id\", :text, true),",
    "replace": "attr_row(:id, \"id\", :text, true),\n    attr_row(:onclick, \"onclick\", :text, true),"
  },
  {
    "name": "event attribute message",
    "file": "gamen.b",
    "find": "if event_key?(key) and not allowed?(tag, key)",
    "replace": "if false"
  },
  {
    "name": "void element closed",
    "file": "gamen.b",
    "find": "\"#{doctype}#{open_tag(node)}\"",
    "replace": "\"#{doctype}#{open_tag(node)}</#{to_s(tag)}>\""
  },
  {
    "name": "bool attribute value",
    "file": "gamen.b",
    "find": "\" #{name}\"",
    "replace": "\" #{name}=\\\"true\\\"\""
  },
