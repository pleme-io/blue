    "find": "get(node, first(p)) == true",
    "replace": "get(node, first(p)) != nil"
  },
  {
    "name": "reset",
    "file": "gamen.b",
    "find": "#{get(node, :text)}#{esc_char}[0m",
    "replace": "#{get(node, :text)}#{esc_char}[m"
  },
  {
    "name": "color off",
    "file": "gamen.b",
    "find": "if is_empty(on) or not get(ctx, :color)",
    "replace": "if is_empty(on)"
  },
  {
    "name": "plain map",
    "file": "gamen.b",
    "find": "if is_empty(on) or not get(ctx, :color)",
    "replace": "if not get(ctx, :color)"
  },
  {
    "name": "list join",
    "file": "gamen.b",
    "find": "join(map((n) -> styled(n, ctx), node), \"\")",
    "replace": "join(map((n) -> styled(n, ctx), node), \" \")"
  },
  {
    "name": "node text",
    "file": "gamen.b",
    "find": "elsif map?(node) and string?(get(node, :text))",
    "replace": "elsif map?(node)"
  },
  {
    "name": "no color env",
    "file": "gamen.b",
    "find": "no_color.nil? or no_color == \"\"",
    "replace": "no_color.nil?"
  },
  {
    "name": "sink wins",
    "file": "gamen.b",
    "find": "  if sink != nil\n    sink",
    "replace": "  if false\n    sink"
  },
  {
    "name": "to stderr",
    "file": "gamen.b",
    "find": "elsif to == :stderr",
    "replace": "elsif to == :stdout"
  },
  {
    "name": "show checked",
    "file": "gamen.b",
    "find": "  checked(opts, [:theme, :color, :sink, :to, :newline])\n",
    "replace": ""
  },
  {
    "name": "show newline",
    "file": "gamen.b",
    "find": "if get(opts, :newline) == false",
    "replace": "if get(opts, :newline) != false"
  },
  {
    "name": "show returns",
    "file": "gamen.b",
    "find": "    write(\"#{text}\\n\")\n  end\n  nil\nend\n",
    "replace": "    write(\"#{text}\\n\")\n  end\n  text\nend\n"
  },
  {
    "name": "show theme",
    "file": "gamen.b",
    "find": "theme: get(opts, :theme)",
    "replace": "theme: nil"
  },
  {
    "name": "stderr writer",
    "file": "gamen.b",
    "find": "(text) -> write_stderr(text)",
    "replace": "(text) -> write_stdout(text)"
  },
  {
    "name": "html text escape",
    "file": "gamen.b",
    "find": "\"<\", \"&lt;\"",
    "replace": "\"<\", \"<\""
  },
  {
    "name": "url scheme javascript",
    "file": "gamen.b",
    "find": "scheme == \"mailto\"",
    "replace": "scheme == \"mailto\" or scheme == \"javascript\""
  },
  {
    "name": "url protocol relative",
    "file": "gamen.b",
    "find": "elsif starts_with?(url, \"//\")",
    "replace": "elsif false"
  },
  {
    "name": "url character allowlist",
    "file": "gamen.b",
