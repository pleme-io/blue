[
  {
    "name": "6.1 padding as long as the payload",
    "file": "tajuu.b",
    "find": "elsif first(payload) >= len",
    "replace": "elsif first(payload) > len"
  },
  {
    "name": "4.2 oversize scope",
    "file": "tajuu.b",
    "find": "if stream == 0 or member?(type, [1, 4, 5, 9])",
    "replace": "if stream == 0 or member?(type, [4, 5, 9])"
  },
  {
    "name": "4.2 SETTINGS_MAX_FRAME_SIZE",
    "file": "tajuu.b",
    "find": "elsif len > max_frame_size",
    "replace": "elsif len > max_frame_size + 1"
  },
  {
    "name": "4.1 reserved bit ignored",
    "file": "tajuu.b",
    "find": "be_value(bytes, 5, 4) % 2_147_483_648",
    "replace": "be_value(bytes, 5, 4)"
  },
  {
    "name": "6.3 PRIORITY is 5 octets",
    "file": "tajuu.b",
    "find": "elsif size(payload) != 5",
    "replace": "elsif size(payload) > 5"
  },
  {
    "name": "6.3 weight is wire plus one",
    "file": "tajuu.b",
    "find": "    weight: bytes[pos + 4] + 1\n",
    "replace": "    weight: bytes[pos + 4]\n"
  },
  {
    "name": "6.5 ack is empty",
    "file": "tajuu.b",
    "find": "elsif ack and len != 0",
    "replace": "elsif false"
  },
  {
    "name": "6.5 length a multiple of 6",
    "file": "tajuu.b",
    "find": "elsif len % 6 != 0",
    "replace": "elsif false"
  },
  {
    "name": "6.5.2 ENABLE_PUSH 0 or 1",
    "file": "tajuu.b",
    "find": "k == :enable_push and v > 1",
    "replace": "k == :enable_push and v > 2"
  },
  {
    "name": "6.5.2 INITIAL_WINDOW_SIZE",
    "file": "tajuu.b",
    "find": "v > 2_147_483_647",
    "replace": "v > 2_147_483_648"
  },
  {
    "name": "6.5.2 MAX_FRAME_SIZE floor",
    "file": "tajuu.b",
    "find": "v < 16384 or v > 16_777_215",
    "replace": "v < 16383 or v > 16_777_215"
  },
  {
    "name": "6.6 promised stream 0",
    "file": "tajuu.b",
    "find": "be_value(body, 0, 4) % 2_147_483_648 == 0",
    "replace": "false"
  },
  {
    "name": "6.7 PING is 8 octets",
    "file": "tajuu.b",
    "find": "elsif size(payload) != 8",
    "replace": "elsif size(payload) > 8"
  },
  {
    "name": "6.8 GOAWAY at least 8",
    "file": "tajuu.b",
    "find": "elsif size(payload) < 8",
    "replace": "elsif size(payload) < 7"
  },
  {
    "name": "6.9 zero increment scope",
    "file": "tajuu.b",
    "find": "elsif inc == 0 and stream == 0",
    "replace": "elsif inc == 0 and stream == 1"
  },
  {
    "name": "6.2 PRIORITY flag written",
    "file": "tajuu.b",
    "find": "    flag(not f[:priority].nil?, 32)\n",
    "replace": "    flag(not f[:priority].nil?, 0)\n"
  },
  {
    "name": "3.4 preface length",
    "file": "tajuu.b",
    "find": "elsif n < 24",
    "replace": "elsif n < 23"
  },
  {
    "name": "5.1 reset from open",
    "file": "tajuu.b",
    "find": "member?(state, [:open, :half_closed_local])",
    "replace": "member?(state, [:half_closed_local])"
  },
  {
    "name": "5.1 recv END_STREAM closes half-closed local",
    "file": "tajuu.b",
    "find": "elsif dir == :recv and state == :half_closed_local",
    "replace": "elsif false"
  },
  {
    "name": "5.1 recv RST closes",
    "file": "tajuu.b",
    "find": "if kind == :rst_stream and state != :closed_after_reset",
    "replace": "if false"
  },
  {
    "name": "5.1 reserved local receives",
    "file": "tajuu.b",
    "find": "member?(kind, [:rst_stream, :priority, :window_update])",
    "replace": "member?(kind, [:rst_stream, :priority])"
  },
  {
    "name": "6.1 DATA on closed is a stream error",
    "file": "tajuu.b",
    "find": "elsif state == :closed and kind == :data",
    "replace": "elsif false"
  },
  {
    "name": "5.1 closed tolerates late frames",
    "file": "tajuu.b",
    "find": "member?(kind, [:priority, :window_update, :rst_stream])",
    "replace": "member?(kind, [:priority])"
  },
  {
    "name": "5.1 promised push opens half-closed remote",
    "file": "tajuu.b",
    "find": "elsif state == :reserved_local and kind == :headers",
    "replace": "elsif false"
  },
  {
    "name": "5.1 END_STREAM only on HEADERS and DATA",
    "file": "tajuu.b",
    "find": "if end_stream and member?(kind, [:headers, :data])",
    "replace": "if false"
  }
]
