  {
    "name": "everything on a known network is inside",
    "file": "toride.b",
    "find": "lan: if run[:local] != nil and inside?(e[:lan], run[:local])",
    "replace": "lan: if run[:local] != nil"
  },
  {
    "name": "a LAN answer serves the tailnet address",
    "file": "toride.b",
    "find": "  address = if o[:kind] == :serve and o[:via] == :lan\n    e[:lan]",
    "replace": "  address = if o[:kind] == :serve and o[:via] == :lan\n    e[:tailnet]"
  },
  {
    "name": "a tailnet answer serves the LAN address",
    "file": "toride.b",
    "find": "  elsif o[:kind] == :serve\n    e[:tailnet]",
    "replace": "  elsif o[:kind] == :serve\n    e[:lan]"
  },
  {
    "name": "a withheld name gets an address line",
    "file": "toride.b",
    "find": "            if a[:address] != nil\n",
    "replace": "            if true\n"
  },
  {
    "name": "a withheld line drops its reason",
    "file": "toride.b",
    "find": "\"# withheld #{d}: #{to_s(a[:outcome][:reason])}\"",
    "replace": "\"# withheld #{d}\""
  },
  {
    "name": "the header drops the gateway",
    "file": "toride.b",
    "find": "\"# site: #{to_s(run[:site])} gateway: #{to_s(run[:gateway])}\"",
    "replace": "\"# site: #{to_s(run[:site])}\""
  },
  {
    "name": "a blind run is written",
    "file": "toride.b",
    "find": "  if not is_empty(unread_among(run, %i[site gateway]))",
    "replace": "  if false"
  },
  {
    "name": "an unchanged file is rewritten",
    "file": "toride.b",
    "find": "    result = if read_or(path, \"\") == text",
    "replace": "    result = if false"
  },
  {
    "name": "a dry run writes",
    "file": "toride.b",
    "find": "    elsif cfg[:dry_run]\n      \"would-write\"",
    "replace": "    elsif false\n      \"would-write\""
  },
  {
    "name": "a failed write is not named",
    "file": "toride.b",
    "find": "    elsif write_atomic(path, text) != true",
    "replace": "    elsif false"
  },
  {
    "name": "a failed reload is not named",
    "file": "toride.b",
    "find": "    elsif reloaded(io, cfg[:reload]) != 0",
    "replace": "    elsif false"
  },
  {
    "name": "the write never lands",
    "file": "toride.b",
    "find": "  rename_file(\"#{path}.tmp\", path)\n  true",
    "replace": "  true"
  },
  {
    "name": "no ports is a probe",
    "file": "toride.b",
    "find": "    bad(\"probe: no ports\")",
    "replace": "    ok(false)"
  },
  {
    "name": "the shared timeout may be zero",
    "file": "toride.b",
    "find": "    per = if share < 1\n      1",
    "replace": "    per = if share < 1\n      0"
  },
  {
    "name": "an unmade probe reads as answered",
    "file": "toride.b",
    "find": "    if r.nil?\n      bad(\"probe:",
    "replace": "    if false\n      bad(\"probe:"
  },
  {
    "name": "an empty port list reaches",
    "file": "toride.b",
    "find": "  if is_empty(ports)\n    false",
    "replace": "  if is_empty(ports)\n    true"
  },
  {
    "name": "a reached port is not reached",
    "file": "toride.b",
    "find": "number?(tcp_connect_ms(addr, first(ports), per))",
    "replace": "false"
  },
  {
    "name": "the nixos route table is read as netstat",
    "file": "toride.b",
    "find": "    if nixos\n      parse_ip_route",
    "replace": "    if nixos\n      parse_netstat"
  },
  {
    "name": "the nixos address is read as ifconfig",
    "file": "toride.b",
    "find": "          (t) -> parse_ip_addr(t, gw[:iface])",
    "replace": "          parse_ifconfig"
  },
  {
    "name": "the nixos neighbours are read as arp",
    "file": "toride.b",
    "find": "        if nixos\n          parse_ip_neigh",
    "replace": "        if nixos\n          parse_arp"
  },
  {
    "name": "no default route is observed further",
    "file": "toride.b",
    "find": "  if gw.nil?\n    {\n      routes:,",
    "replace": "  if false\n    {\n      routes:,"
  },
  {
    "name": "nixos reads routes with netstat",
    "file": "toride.b",
    "find": "    ip_route_argv(cfg[:ip])",
    "replace": "    [cfg[:netstat], \"-rn\", \"-f\", \"inet\"]"
  },
  {
    "name": "nixos reads the address with ifconfig",
    "file": "toride.b",
    "find": "[cfg[:ip], \"-4\", \"-o\", \"addr\", \"show\", \"dev\", iface]",
    "replace": "[cfg[:ifconfig], iface]"
  },
  {
    "name": "nixos reads neighbours with arp",
    "file": "toride.b",
    "find": "[cfg[:ip], \"-4\", \"neigh\", \"show\", \"dev\", iface]",
    "replace": "[cfg[:arp], \"-an\"]"
  },
  {
    "name": "the streak is forgotten",
    "file": "toride.b",
    "find": "streak: get_if(doc, \"streak\", integer?, 0)",
    "replace": "streak: 0"
  },
  {
    "name": "the run count is forgotten",
    "file": "toride.b",
    "find": "runs: get_if(doc, \"runs\", integer?, 0)",
    "replace": "runs: 0"
  },
  {
    "name": "withheld is counted as served",
    "file": "toride.b",
    "find": "withheld=#{to_s(size(c[:answers]) - size(served))}",
    "replace": "withheld=#{to_s(size(served))}"
  },
  {
    "name": "the heartbeat never beats",
    "file": "toride.b",
    "find": "runs % heartbeat == 0",
    "replace": "runs % heartbeat == 1"
  },
  {
    "name": "a changed line is quiet",
    "file": "toride.b",
    "find": "  line != prior_line or",
    "replace": "  false or"
  },
  {
    "name": "an unreadable config is observed",
    "file": "toride.b",
    "find": "  r = if cfg[:readable]",
    "replace": "  r = if true"
  },
  {
    "name": "runs count twice",
    "file": "toride.b",
    "find": "  runs = prior[:runs] + 1",
    "replace": "  runs = prior[:runs] + 2"
  },
  {
    "name": "refusals are not recorded",
    "file": "toride.b",
    "find": "    refused: map(last, refusals)",
    "replace": "    refused: []"
  }
]
