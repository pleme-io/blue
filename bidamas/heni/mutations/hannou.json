    "replace": "r[:name]"
  },
  {
    "name": "every entry renders enabled",
    "file": "hannou.b",
    "find": "enabled: r[:enabled]}",
    "replace": "enabled: true}"
  },
  {
    "name": "entries keep declaration order",
    "file": "hannou.b",
    "find": "sort_keyed((r) -> r[:name], filter((r) -> r[:event] == e, rs))",
    "replace": "filter((r) -> r[:event] == e, rs)"
  },
  {
    "name": "render skips validation",
    "file": "hannou.b",
    "find": "  enforce(rs, [validate])\n",
    "replace": "  nil\n"
  },
  {
