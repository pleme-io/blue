    "replace": "false,"
  },
  {
    "name": "zero seconds is a positive integer",
    "file": "hannou.b",
    "find": "integer?(t) and t > 0",
    "replace": "integer?(t) and t >= 0"
  },
  {
    "name": "a fractional threshold is an integer",
    "file": "hannou.b",
    "find": "integer?(t) and t > 0",
    "replace": "t > 0"
  },
  {
