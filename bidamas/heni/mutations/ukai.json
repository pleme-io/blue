[
  {
    "name": "stale routes are never retracted",
    "file": "ukai.b",
    "find": "  stale = o[:kind] != :blind and s[:stale] == :present\n",
    "replace": "  stale = false\n"
  },
  {
    "name": "a blind answer retracts too",
    "file": "ukai.b",
    "find": "  stale = o[:kind] != :blind and s[:stale] == :present\n",
    "replace": "  stale = s[:stale] == :present\n"
  },
  {
    "name": "a detour held through the own gateway outlives a noop",
    "file": "ukai.b",
    "find": "  held = o[:kind] == :noop and s[:held] == :present\n",
    "replace": "  held = false\n"
  },
  {
    "name": "a refusal retracts the detour it reads enforcement through",
    "file": "ukai.b",
    "find": "  held = o[:kind] == :noop and s[:held] == :present\n",
    "replace": "  held = o[:kind] != :blind and s[:held] == :present\n"
  },
  {
    "name": "a stale host is retracted as held too",
    "file": "ukai.b",
    "find": "member?(h, routed) and not member?(h, stale), unique(applied)",
    "replace": "member?(h, routed), unique(applied)"
  },
  {
    "name": "a host never applied is retracted",
    "file": "ukai.b",
    "find": "          member?(r_dest(r), applied) and\n",
    "replace": "          true and\n"
  },
  {
    "name": "a route through the current gateway reads stale",
    "file": "ukai.b",
    "find": "            r[:gateway] != gateway and\n",
    "replace": "            true and\n"
  },
  {
    "name": "a move between networks reads as rewritten routes",
    "file": "ukai.b",
    "find": "    (h) -> not member?(h, routed) and not member?(h, stale),",
    "replace": "    (h) -> not member?(h, routed),"
  },
  {
    "name": "a retracted nixos host is not added back",
    "file": "ukai.b",
    "find": "  held = difference(as_set(s[:routed]), as_set(s[:stale_hosts]))",
    "replace": "  held = as_set(s[:routed])"
  },
  {
    "name": "a nixos table route through an old gateway is kept",
    "file": "ukai.b",
    "find": "      filter((r) -> ipv4?(r[:gateway]) and r[:gateway] != gateway, rows)",
    "replace": "      filter((r) -> false, rows)"
  },
  {
    "name": "an unreadable table reads as no stale routes",
    "file": "ukai.b",
    "find": "  if not routes_ok or not ok?(table_r)\n    :unread",
    "replace": "  if not routes_ok\n    :unread"
  },
  {
    "name": "a retract leaves its hosts in the record",
    "file": "ukai.b",
    "find": "      difference(as_set(applied), as_set(o[:retract][:hosts]))",
    "replace": "      applied"
  },
  {
    "name": "an address change on the same gateway leaves the dead routes",
    "file": "ukai.b",
    "find": "  elsif addr_moved?(cfg[:platform], cfg[:applied_addr], iface_addr)\n",
    "replace": "  elsif false\n"
  },
  {
    "name": "an address change retracts only the routes through an old gateway",
    "file": "ukai.b",
    "find": "        filter((h) -> member?(h, routed), cfg[:applied])\n",
    "replace": "        []\n"
  },
  {
    "name": "an unchanged address reads as moved",
    "file": "ukai.b",
    "find": "    applied_addr != iface_addr\n",
    "replace": "    true\n"
  },
  {
    "name": "an unread address reads as moved",
    "file": "ukai.b",
    "find": "    not is_empty(iface_addr) and\n",
    "replace": "    true and\n"
  },
  {
    "name": "a bypass keeps the old applied address",
    "file": "ukai.b",
    "find": "  elsif o[:kind] == :bypass\n    iface_addr\n",
    "replace": "  elsif o[:kind] == :bypass\n    prev\n"
  },
  {
    "name": "no held host keeps the applied address",
    "file": "ukai.b",
    "find": "  elsif is_empty(applied)\n    \"\"\n",
    "replace": "  elsif is_empty(applied)\n    prev\n"
  }
]
