[
  {
    "name": "the file tier defaults to JSON",
    "file": "settei.b",
    "find": "  format = if chosen.nil?\n    :yaml",
    "replace": "  format = if chosen.nil?\n    :json"
  },
  {
    "name": "the chosen format is ignored",
    "file": "settei.b",
    "find": "deeta::parse(read_file(path), format)",
    "replace": "deeta::parse(read_file(path), :json)"
  },
  {
    "name": "the environment is read before the file",
    "file": "settei.b",
    "find": "def layers()\n  %i[file env flag]",
    "replace": "def layers()\n  %i[env file flag]"
  },
  {
    "name": "a value under its floor stands",
    "file": "settei.b",
    "find": "k[:min] != nil and v < k[:min] or",
    "replace": "k[:min] != nil and v < k[:min] - 1000000 or"
  },
  {
    "name": "a layer outside set_by still sets the knob",
    "file": "settei.b",
    "find": "elsif not member?(layer, k[:set_by])",
    "replace": "elsif false"
  },
  {
    "name": "a secret is shown",
    "file": "settei.b",
    "find": "def shown_value(k, v)\n  if k[:secret]",
    "replace": "def shown_value(k, v)\n  if false"
  },
  {
    "name": "every knob gets a flag",
    "file": "settei.b",
    "find": "def by_flag?(k)\n  member?(:flag, k[:set_by])",
    "replace": "def by_flag?(k)\n  true"
  },
  {
    "name": "the frame's positionals count as unmodelled",
    "file": "settei.b",
    "find": "append(%w[command help], map((s) -> to_s(s[:name]), slots), own)",
    "replace": "append(%w[command help], own)"
  },
  {
    "name": "a secret is not redacted",
    "file": "settei.b",
    "find": "if r[:knob][:secret] and doc_at(acc, r[:path]) != nil",
    "replace": "if false and doc_at(acc, r[:path]) != nil"
  },
  {
    "name": "an immutable knob moves on reload",
    "file": "settei.b",
    "find": "if k[:immutable] and was != now",
    "replace": "if false and was != now"
  },
  {
    "name": "a renamed knob's old environment name is not read",
    "file": "settei.b",
    "find": "map((old) -> env_name(app, split(old, \".\")), k[:renamed])",
    "replace": "[]"
  },
  {
    "name": "a required knob is optional",
    "file": "settei.b",
    "find": "elsif k[:required] and doc_at(acc[:config], r[:path]).nil?",
    "replace": "elsif false and doc_at(acc[:config], r[:path]).nil?"
  },
  {
    "name": "a group's schema stays open",
    "file": "settei.b",
    "find": "\"additionalProperties\" => false,",
    "replace": "\"additionalProperties\" => true,"
  },
  {
    "name": "a form takes an edit outside the bounds",
    "file": "settei.b",
    "find": "    why_not(k, v)\n  end\n  edited",
    "replace": "    nil\n  end\n  edited"
  },
  {
    "name": "a bounded number loses its range in the module trio",
    "file": "settei.b",
    "find": "base = if t == :int and k[:min] != nil and k[:max] != nil",
    "replace": "base = if false and k[:min] != nil and k[:max] != nil"
  }
]
