[
  {
    "name": "the magic is not checked",
    "file": "erufu.b",
    "find": "slice_bytes(bytes, 0, 4) != [127, 69, 76, 70]",
    "replace": "false"
  },
  {
    "name": "a big-endian object is read",
    "file": "erufu.b",
    "find": "if bytes[4] != 2 or bytes[5] != 1",
    "replace": "if bytes[4] != 2"
  },
  {
    "name": "the machine is not BPF",
    "file": "erufu.b",
    "find": "machine: 247,",
    "replace": "machine: 62,"
  },
  {
    "name": "another machine's object is linked",
    "file": "erufu.b",
    "find": "if o[:header][:machine] != 247",
    "replace": "if false"
  },
  {
    "name": "a global call keeps its offset",
    "file": "erufu.b",
    "find": "insn: assoc(i, :imm, -1)",
    "replace": "insn: i"
  },
  {
    "name": "a map reference keeps its pseudo source",
    "file": "erufu.b",
    "find": "        assoc(assoc(i, :src, 0), :imm, 0)\n",
    "replace": "        assoc(i, :imm, 0)\n"
  },
  {
    "name": "symbols are not ordered locals first",
    "file": "erufu.b",
    "find": "    filter((s) -> s[:bind] == :local, symbols),\n    filter((s) -> s[:bind] != :local, symbols)",
    "replace": "    filter((s) -> s[:bind] != :local, symbols),\n    filter((s) -> s[:bind] == :local, symbols)"
  },
  {
    "name": "a relocation's symbol is off by one",
    "file": "erufu.b",
    "find": "shift_left(at + 1, 32)",
    "replace": "shift_left(at, 32)"
  },
  {
    "name": "the license has no NUL",
    "file": "erufu.b",
    "find": "text_bytes(given[:license] or \"GPL\"), [0])",
    "replace": "text_bytes(given[:license] or \"GPL\"), [])"
  },
  {
    "name": "a linked call forgets where .text landed",
    "file": "erufu.b",
    "find": "to = floor(rel[:sym][:value] / 8) + i[:imm] + 1 + text_base",
    "replace": "to = floor(rel[:sym][:value] / 8) + i[:imm] + 1"
  },
  {
    "name": "unbound fields are written anyway",
    "file": "erufu.b",
    "find": "if (p[:fields] or []) != []",
    "replace": "if false"
  },
  {
    "name": "func_info keeps the order of its sections",
    "file": "erufu.b",
    "find": "(r) -> r[:at],\n",
    "replace": "(r) -> 0,\n"
  },
  {
    "name": "a function nothing reaches stays",
    "file": "erufu.b",
    "find": "linked = if given[:keep_unreached] or not reaches_text",
    "replace": "linked = if true"
  },
  {
    "name": "a reference does not keep its target",
    "file": "erufu.b",
    "find": "if i[:code] == 133 and i[:src] == 1 or i[:code] == 24 and i[:src] == 4",
    "replace": "if i[:code] == 133 and i[:src] == 1"
  },
  {
    "name": "a dropped function leaves its callers' offsets",
    "file": "erufu.b",
    "find": "assoc(row[1], :imm, moved(target) - moved(first(row)) - 1)",
    "replace": "row[1]"
  },
  {
    "name": "a reader ignores the switch that keeps every function",
    "file": "erufu.b",
    "find": "      not given[:keep_unreached] or\n",
    "replace": "      true or\n"
  },
  {
    "name": "a reference into a value holds no offset",
    "file": "erufu.b",
    "find": "assoc(assoc(assoc(i, :src, 0), :imm, i[:imm2]), :imm2, 0)",
    "replace": "assoc(assoc(i, :src, 0), :imm, 0)"
  },
  {
    "name": "a kernel field holds no local offset",
    "file": "erufu.b",
    "find": "{insn: assoc(i, :imm, get(world[:field_offsets], slot))}",
    "replace": "{insn: i}"
  },
  {
    "name": "a CO-RE relocation of another kind is read",
    "file": "erufu.b",
    "find": "if r[:kind] != 0",
    "replace": "if false"
  },
  {
    "name": "a relocation at no immediate is read",
    "file": "erufu.b",
    "find": "not member?(row[1][:code], [7, 183])",
    "replace": "false"
  },
  {
    "name": "a map named both ways is written",
    "file": "erufu.b",
    "find": "elsif member?(name, plain)",
    "replace": "elsif false"
  },
  {
    "name": "a value map of any shape is written",
    "file": "erufu.b",
    "find": "elsif m[:kind] != :array or m[:max_entries] != 1 or m[:key_size] != 4",
    "replace": "elsif false"
  },
  {
    "name": "an object holds no source lines",
    "file": "erufu.b",
    "find": "bpf::line_info_sections(types[:lines] or [], funcs, section),",
    "replace": "[],"
  },
  {
    "name": "an object holds no CO-RE relocations",
    "file": "erufu.b",
    "find": "bpf::core_sections(types[:core_relos] or [], funcs, section)",
    "replace": "[]"
  },
  {
    "name": "the line info switch does nothing",
    "file": "erufu.b",
    "find": "if given[:line_info] == false",
    "replace": "if false"
  },
  {
    "name": "the CO-RE switch does nothing",
    "file": "erufu.b",
    "find": "if (p[:fields] or []) != [] and given[:core] == false",
    "replace": "if false"
  },
  {
    "name": "a stuck relocation goes on",
    "file": "erufu.b",
    "find": "if stuck != nil",
    "replace": "if false"
  }
]
