[
  {
    "name": "an unread axis is decided anyway",
    "file": "toride.b",
    "find": "  if not is_empty(unread)\n    {kind: :blind, unread:}",
    "replace": "  if false\n    {kind: :blind, unread:}"
  },
  {
    "name": "home ignores a down gateway",
    "file": "toride.b",
    "find": "elsif s[:site] == :here and s[:gateway] == :up",
    "replace": "elsif s[:site] == :here"
  },
  {
    "name": "any site with a live gateway is home",
    "file": "toride.b",
    "find": "elsif s[:site] == :here and s[:gateway] == :up",
    "replace": "elsif s[:gateway] == :up"
  },
  {
    "name": "a node away keeps its LAN address",
    "file": "toride.b",
    "find": "  elsif s[:entry] == :node\n    {kind: :serve, via: :tailnet}",
    "replace": "  elsif s[:entry] == :node\n    {kind: :serve, via: :lan}"
  },
  {
    "name": "the routed service is taken for the lan-only one",
    "file": "toride.b",
    "find": "elsif s[:entry] == :local_service",
    "replace": "elsif s[:entry] == :routed_service"
  },
  {
    "name": "a lan-only service away is served",
    "file": "toride.b",
    "find": "  elsif s[:entry] == :local_service\n    {kind: :withheld, reason: :lan_only}",
    "replace": "  elsif s[:entry] == :local_service\n    {kind: :serve, via: :lan}"
  },
  {
    "name": "the shadow test is inverted",
    "file": "toride.b",
    "find": "  elsif s[:lan] == :inside",
    "replace": "  elsif s[:lan] == :outside"
  },
  {
    "name": "a shadowed service is served",
    "file": "toride.b",
    "find": "    {kind: :withheld, reason: :shadowed_by_local_lan}",
    "replace": "    {kind: :serve, via: :lan}"
  },
  {
    "name": "the withheld label drops its reason",
    "file": "toride.b",
    "find": "\"withheld:#{to_s(o[:reason])}\"",
    "replace": "\"withheld\""
  },
  {
    "name": "the serve label drops its route",
    "file": "toride.b",
    "find": "  elsif o[:kind] == :serve\n    to_s(o[:via])",
    "replace": "  elsif o[:kind] == :serve\n    \"lan\""
  },
  {
    "name": "the blind label drops its axes",
    "file": "toride.b",
    "find": "\"blind:#{join(map(to_s, o[:unread]), \",\")}\"",
    "replace": "\"blind\""
  },
  {
    "name": "a state outside its axes is accepted",
    "file": "toride.b",
    "find": "  if is_empty(wrong)\n    m",
    "replace": "  if true\n    m"
  },
  {
    "name": "an octet weighs 255",
    "file": "toride.b",
    "find": "acc * 256 + to_int(o)",
    "replace": "acc * 255 + to_int(o)"
  },
  {
    "name": "int_ip repeats an octet",
    "file": "toride.b",
    "find": "[16_777_216, 65536, 256, 1]",
    "replace": "[16_777_216, 65536, 256, 256]"
  },
  {
    "name": "a prefix bit triples",
    "file": "toride.b",
    "find": "reduce((acc, _i) -> acc * 2, 1, range(0, 32 - prefix))",
    "replace": "reduce((acc, _i) -> acc * 3, 1, range(0, 32 - prefix))"
  },
  {
    "name": "a /33 is a prefix",
    "file": "toride.b",
    "find": "or p < 0 or p > 32",
    "replace": "or p < 0 or p > 33"
  },
  {
    "name": "a negative prefix is a prefix",
    "file": "toride.b",
    "find": "p.nil? or p < 0",
    "replace": "p.nil? or p < -1"
  },
  {
    "name": "a cidr base need not be IPv4",
    "file": "toride.b",
    "find": "  if size(ps) != 2 or not ipv4?(first(ps)) or",
    "replace": "  if size(ps) != 2 or"
  },
  {
    "name": "a cidr is not rounded to its network",
    "file": "toride.b",
    "find": "{network: floor(ip_int(first(ps)) / span(p)) * span(p), prefix: p}",
    "replace": "{network: ip_int(first(ps)), prefix: p}"
  },
  {
    "name": "inside? is off by one network",
    "file": "toride.b",
    "find": "    floor(net[:network] / span(net[:prefix]))\n",
    "replace": "    floor(net[:network] / span(net[:prefix])) + 1\n"
  },
  {
    "name": "a netmask counts its zero bits",
    "file": "toride.b",
    "find": "bit_and(n, span(32 - i)) != 0",
    "replace": "bit_and(n, span(32 - i)) == 0"
  },
  {
    "name": "a short octet is not padded",
    "file": "toride.b",
    "find": "\"0#{o}\"",
    "replace": "o"
  },
  {
    "name": "a three-digit octet is a MAC octet",
    "file": "toride.b",
    "find": "size(chars(o)) <= 2 and",
    "replace": "size(chars(o)) <= 3 and"
  },
  {
    "name": "an empty octet is a MAC octet",
    "file": "toride.b",
    "find": "size(chars(o)) >= 1 and",
    "replace": "size(chars(o)) >= 0 and"
  },
  {
    "name": "seven octets make a MAC",
    "file": "toride.b",
    "find": "if size(os) == 6 and",
    "replace": "if size(os) >= 6 and"
  },
  {
    "name": "a non-hex octet is a MAC octet",
    "file": "toride.b",
    "find": "is_empty(filter((c) -> not member?(c, hex_digits), chars(o)))",
    "replace": "true"
  },
  {
    "name": "the redacted MAC is a reading",
    "file": "toride.b",
    "find": "mac == \"02:00:00:00:00:00\"",
    "replace": "mac == \"02:00:00:00:00:01\""
  },
  {
    "name": "nixos reads as darwin",
