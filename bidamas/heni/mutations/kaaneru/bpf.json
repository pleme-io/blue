[
  {
    "name": "encode swaps dst and src nibbles",
    "file": "bpf.b",
    "find": "bit_or(bit_and(dst, 15), shift_left(bit_and(src, 15), 4))",
    "replace": "bit_or(bit_and(src, 15), shift_left(bit_and(dst, 15), 4))"
  },
  {
    "name": "imm64 takes the wrong high half",
    "file": "bpf.b",
    "find": "bit_and(shift_right(value, 32), 4_294_967_295)",
    "replace": "bit_and(shift_right(value, 31), 4_294_967_295)"
  },
  {
    "name": "a label is one slot off",
    "file": "bpf.b",
    "find": "at - pc - 1",
    "replace": "at - pc"
  },
  {
    "name": "a jump past 16 bits is let through",
    "file": "bpf.b",
    "find": "if n < -32768 or n > 32767",
    "replace": "if false"
  },
  {
    "name": "32-bit ALU keeps the upper half",
    "file": "bpf.b",
    "find": "low32(alu64_value(op, x, y))",
    "replace": "alu64_value(op, x, y)"
  },
  {
    "name": "division by zero answers one",
