use("junjo", [:sort_by])
use("retsu", [:last])

manifest = get(
  json_read(read_file(path_join(getenv("GEN_ROOT", "."), "Bluefile.lock"))),
  "manifest"
)

outputs = map(
  (e) -> get(last(e), "output"),
  map_entries(get(manifest, "generated") or {})
)

generated = if get(manifest, "catalog").nil?
  outputs
else
  append([get(manifest, "catalog")], outputs)
end

lines = append(
  [
    "# Generated by gen/gitattributes.b from Bluefile.lock. Do not edit by hand: nix run .#regen.",
    "# merge=blue-generated regenerates the file from the merged tree (gen/merge.b, .githooks/config).",
    "Bluefile.lock merge=blue-generated",
    "/bidamas/NAMES.md merge=union"
  ],
  map((p) -> "/#{p} merge=blue-generated", sort_by((p) -> p, generated))
)

write_file(getenv("GEN_OUT", ".gitattributes"), "#{join(lines, "\n")}\n")
