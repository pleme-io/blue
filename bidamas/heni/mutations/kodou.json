[
  {
    "name": "be32 little-endian",
    "file": "kodou.b",
    "find": "    floor(n / 16_777_216) % 256,\n    floor(n / 65536) % 256,\n    floor(n / 256) % 256,\n    n % 256",
    "replace": "    n % 256,\n    floor(n / 256) % 256,\n    floor(n / 65536) % 256,\n    floor(n / 16_777_216) % 256"
  },
  {
    "name": "parts pass their room",
    "file": "kodou.b",
    "find": "if acc.bytes + b > room and acc.cur != \"\"",
    "replace": "if acc.bytes + b > room + 1 and acc.cur != \"\""
  },
  {
    "name": "part index past its count reads",
    "file": "kodou.b",
    "find": "index < 0 or index >= count",
    "replace": "index < 0 or index > count"
  },
  {
    "name": "part body without its separator reads",
    "file": "kodou.b",
    "find": "elsif starts_with?(body, \"P\") and starts_with?(drop_chars(rest, 67), \":\")",
    "replace": "elsif starts_with?(body, \"P\")"
  },
  {
    "name": "a capability kensa cannot name is kept",
    "file": "kodou.b",
    "find": "if not member?(v.capability, kensa_capabilities)",
    "replace": "if false"
  },
  {
    "name": "an edited immunity file reads",
    "file": "kodou.b",
    "find": "if immunity_digest(entries) != doc[\"digest\"]",
    "replace": "if false"
  },
  {
    "name": "an unsorted immunity file reads",
    "file": "kodou.b",
    "find": "(i) -> compare(hashes[i], hashes[i + 1]) < 0,",
    "replace": "(i) -> true,"
  },
  {
    "name": "a data frame is not acknowledged",
    "file": "kodou.b",
    "find": "    tide_send(\n      l.wire,\n      f.from,",
    "replace": "    nil and tide_send(\n      l.wire,\n      f.from,"
  },
  {
    "name": "the bucket's MTU refusal is ignored",
    "file": "kodou.b",
    "find": "  if r.verdict == :refused",
    "replace": "  if false"
  },
  {
    "name": "the window ignores flight",
    "file": "kodou.b",
    "find": "  room = blue::max(0, l.tide.cwnd - l.flight)",
    "replace": "  room = l.tide.cwnd"
  },
  {
    "name": "an ack leaves bytes in flight",
    "file": "kodou.b",
    "find": "    flight: blue::max(0, l.flight - bytes)",
    "replace": "    flight: l.flight"
  },
  {
    "name": "an artifact that hashes elsewhere is kept",
    "file": "kodou.b",
    "find": "  if got != hash",
    "replace": "  if false"
  },
  {
    "name": "a non-canonical artifact is kept",
    "file": "kodou.b",
    "find": "  elsif canon != text",
    "replace": "  elsif false"
  },
  {
    "name": "a lying alert is believed",
    "file": "kodou.b",
    "find": "if a[\"def_hash\"] != alert.def_hash or a[\"class\"] != alert.class",
    "replace": "if false"
  },
  {
    "name": "a known crash is wanted again",
    "file": "kodou.b",
    "find": "      has?(n.wanted, h) or\n      member?(h, n.known)",
    "replace": "      has?(n.wanted, h)"
  },
  {
    "name": "a host refusal is not waited out",
    "file": "kodou.b",
    "find": "      sleep_ms(e.data.wait_ms)\n      flash_put(l.wire, peer, payload)",
    "replace": "      flash_put(l.wire, peer, payload)"
  }
]
