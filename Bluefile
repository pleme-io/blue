# The blue repository's own build facts, stated in blue.
#
# "We write bluelang, we leverage nix": this file declares what the repository
# generates and where its packages live; `blue lock .` evaluates it into
# Bluefile.lock, and blue's flake lowers that lock through the same engine
# every blue project uses (`nix/project.nix`, `lib.project`). For every
# `generate`:
#
#   packages.generated-<name>      the file, built by running its program
#   checks.generated-<name>-fresh  fails when the committed copy is stale
#   apps.regen                     rewrites every generated file in place
#
# plus the catalogue check for `catalog`, and for `packages` a
# `bidama-test-<pkg>` check per package, the collision gate and the lock
# gate. One declaration, no second list: edit a word here, run `blue lock .`,
# and every consumer follows.
#
# The package identity is this declaration's, not the crates'. Cargo.toml
# carries the crate versions, and the release job bumps those.
package("blue-repository", "1.0.0", :public)

registry(:sui, {outputs: ["default"]})
registry(:flakehub, {tag: :rolling})

packages("bidamas")
catalog("bidamas/CATALOG.md")

# kueri's end-to-end tests run their rendered SQL through the `duckdb` binary,
# so every bidama's `bidama-test-*` check has it on PATH.
tool("duckdb")
tool("git")
# tehai's test starts a real ssh as its control (a missing binary must fail
# differently from a reachable one); a Linux sandbox has no ssh unless named.
tool("openssh")
# tehai's substituter run reads a dead port's nix-cache-info with a real curl.
tool("curl")

# kigou's character tables: authored in blue, rendered into blue-lang-syntax's
# Rust by the `sabi` bidama.
generate("kigou-tables", "crates/blue-lang-syntax/src/kigou/tables.rs", "crates/blue-lang-syntax/gen/kigou.b")
generate("okite-rules", "bidamas/okite/RULES.md", "gen/okite-rules.b")

# blue's one grammar spec (bidamas/kiwari) and everything emitted from it: the
# tree-sitter grammar editors build, its queries, and the spec as JSON for
# blue-lang-kiwari's differential against blue's own parser.
generate("kiwari-grammar", "tree-sitter-blue/grammar.js", "gen/kiwari/grammar.b")
generate("kiwari-metadata", "tree-sitter-blue/tree-sitter.json", "gen/kiwari/metadata.b")
generate("kiwari-highlights", "tree-sitter-blue/queries/highlights.scm", "gen/kiwari/highlights.b")
generate("kiwari-folds", "tree-sitter-blue/queries/folds.scm", "gen/kiwari/folds.b")
generate("kiwari-indents", "tree-sitter-blue/queries/indents.scm", "gen/kiwari/indents.b")
generate("kiwari-locals", "tree-sitter-blue/queries/locals.scm", "gen/kiwari/locals.b")
generate("kiwari-spec", "crates/blue-lang-kiwari/blue.kiwari.json", "gen/kiwari/spec.b")

# The language reference, from `blue reference` (the tables the implementation
# runs on) and, to say which built-in names a bidama redefines, the bidamas.
generate("reference", "docs/REFERENCE.md", "gen/reference.b", ["bidamas"])

# The golden corpus as one file of examples, from examples/ (a blue project of
# its own, run by `checks.examples`).
generate("examples", "docs/EXAMPLES.md", "gen/examples.b", ["examples"])
generate("readme", "README.md", "gen/hon/readme.b", ["Bluefile.lock", "docs"])
generate("agents", "AGENTS.md", "gen/hon/agents.b", ["Bluefile.lock", "docs"])
generate("claude", "CLAUDE.md", "gen/hon/claude.b", ["Bluefile.lock", "docs"])
generate("llms", "llms.txt", "gen/hon/llms.b", ["Bluefile.lock", "docs"])
generate("llms-full", "llms-full.txt", "gen/hon/llms-full.b", ["Bluefile.lock", "docs"])
generate("book", "docs/BOOK.md", "gen/hon/book.b", ["Bluefile.lock", "docs", "bidamas"])
generate("kyasshu-keys", "bidamas/kyasshu/keys/kensa.json", "gen/kyasshu-keys.b", ["bidamas/danpen/fixtures/schema/kensa.graphql"])
check("okite-laws", "gen/okite-laws.b")
check("regen-untracked", "gen/regen_test.b", ["gen/regen.b"])
check("docs", "gen/docs.b", ["docs"])

# The repository's own check rules, written in blue: `blue check` runs each
# on every file under this directory, under a pure frame
# (docs/DIAGNOSTICS.md, "Project rules"). The check runs the rules' tests.
rule("R0001", "rules/conventions.b", "nil_predicate")
check("project-rules", "rules/conventions.b")

# The verb graph (bidamas/mokuroku/graph, docs/verbs/H/DESIGN.md): gates G1,
# G2, G4, G7 and G9 over its rows, held by a hadome baseline of recorded debt,
# each with a fixture that names its bad row.
check("verb-graph", "gen/verb-graph.b")
check("heni-mutations", "gen/heni-gate.b")

# Tests live beside what they test (docs/TESTING.md): every bidama definition
# is reached by a test in its package, or waived with a why and a date, or
# held as recorded debt that may only shrink. Configured in the file itself.
check("test-beside", "gen/test-beside.b")
