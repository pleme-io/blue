[
  {
    "name": "declare stops opening config groups",
    "file": "motenashi.b",
    "find": "  judged = judge(schema, open_fields(entries))",
    "replace": "  judged = judge(schema, entries)"
  },
  {
    "name": "declare forgets to restore a group's fields",
    "file": "motenashi.b",
    "find": "    accepted: map(restored, judged[:accepted]),",
    "replace": "    accepted: judged[:accepted],"
  },
  {
    "name": "declare drops refusals",
    "file": "motenashi.b",
    "find": "    refusals: judged[:refusals]",
    "replace": "    refusals: []"
  },
  {
    "name": "off is lost",
    "file": "motenashi.b",
    "find": "    off: judged[:off],",
    "replace": "    off: [],"
  },
  {
    "name": "a bind takes any action",
    "file": "motenashi.b",
    "find": "    bind: [required(field(:action, one_of(actions)))],",
    "replace": "    bind: [required(field(:action, number_field))],"
  },
  {
    "name": "a provider takes any capability",
    "file": "motenashi.b",
    "find": "      field(:allow, list_of(one_of(capabilities))),",
    "replace": "      field(:allow, number_field),"
  },
  {
    "name": "an action word goes missing",
    "file": "motenashi.b",
    "find": "  %i[hide next previous execute delete_back delete_word clear]",
    "replace": "  %i[hide previous execute delete_back delete_word clear]"
  },
  {
    "name": "color stops dividing",
    "file": "motenashi.b",
    "find": "    map((v) -> v / 255.0, values)",
    "replace": "    values"
  },
  {
    "name": "color lets a bad digit through",
    "file": "motenashi.b",
    "find": "  if size(filter(number?, values)) == 3",
    "replace": "  if size(values) == 3"
  },
  {
    "name": "a row's fields overrule its title",
    "file": "motenashi.b",
    "find": "  {**fields, title:}",
    "replace": "  {title:, **fields}"
  },
  {
    "name": "copy loses its text",
    "file": "motenashi.b",
    "find": "  {kind: \"copy\", text: words}",
    "replace": "  {kind: \"copy\", text: nil}"
  },
  {
    "name": "without keeps the wrong name",
    "file": "motenashi.b",
    "find": "  entry(:without, to_s(builtin), {})",
    "replace": "  entry(:without, \"x\", {})"
  }
]
