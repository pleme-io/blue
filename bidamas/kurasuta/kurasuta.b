@moduledoc """
kurasuta (クラスタ, a cluster): Kubernetes, spoken from blue.

One level today: `kurasuta::kinds`, the typed kinds as records, generated by engenho-kube-codegen from the vendored OpenAPI schema. The reads `list`, `get`, `need` and `watch` (docs/STDLIB.md section 4.18) join this root later; writes stay with GitOps. The root defines nothing.

    catalog.service.plural #=> "services"
"""

use(
  "kurasuta/kinds",
  %i[
    catalog
    config_map
    config_map?
    container
    deployment
    deployment?
    deployment_spec
    label_selector
    network_policy
    network_policy?
    network_policy_ingress_rule
    network_policy_peer
    network_policy_spec
    object_meta
    pod_spec
    pod_template_spec
    policy_rule
    role
    role?
    role_binding
    role_binding?
    role_ref
    secret
    secret?
    service
    service?
    service_account
    service_account?
    service_port
    service_spec
    subject
    unset
    wire_names
  ]
)

@doc """
greeter: a two-replica Deployment of one container, built from the generated records: the object the greeter chart renders.

    greeter.spec.replicas #=> 2
"""
def greeter()
  labels = {app: "greeter"}
  app = container(**unset.container, name: "greeter", image: "greeter:1")
  pod = pod_spec(**unset.pod_spec, containers: [app])
  template = pod_template_spec(
    **unset.pod_template_spec,
    metadata: object_meta(**unset.object_meta, labels:),
    spec: pod
  )
  spec = deployment_spec(
    **unset.deployment_spec,
    replicas: 2,
    selector: label_selector(**unset.label_selector, match_labels: labels),
    template:
  )
  deployment(
    **unset.deployment,
    metadata: object_meta(
      **unset.object_meta,
      name: "greeter",
      namespace: "web"
    ),
    spec:
  )
end

test "a deployment builds from the generated records"
  d = greeter
  assert deployment?(d)
  assert d.metadata.name == "greeter"
  assert d.spec.template.spec.containers[0].image == "greeter:1"
  assert d.spec.selector.match_labels == {app: "greeter"}
  assert catalog.deployment.kind == "Deployment"
  assert catalog.deployment.scope == :namespaced
end

test "a record built at run time refuses an unknown field and names it"
  make = deployment
  e = begin
    make({**unset.deployment, replicas: 3})
  rescue :record as err
    err
  end
  assert e.data.unknown == [:replicas]
end

test "a required field is typed"
  e = begin
    make = container
    make({**unset.container, name: 7})
  rescue :record as err
    err
  end
  assert e.kind == :record
end

test "the rest of the first set constructs"
  meta = object_meta(**unset.object_meta, name: "x")
  assert config_map?(
    config_map(**unset.config_map, metadata: meta, data: {a: "1"})
  )
  assert secret?(secret(**unset.secret, metadata: meta, string_data: {k: "v"}))
  assert service_account?(
    service_account(**unset.service_account, metadata: meta)
  )
  port = service_port(**unset.service_port, port: 80)
  assert service?(
    service(
      **unset.service,
      spec: service_spec(**unset.service_spec, ports: [port])
    )
  )
  rule = policy_rule(**unset.policy_rule, verbs: ["get"], resources: ["pods"])
  assert role?(role(**unset.role, metadata: meta, rules: [rule]))
  ref = role_ref(
    {api_group: "rbac.authorization.k8s.io", kind: "Role", name: "x"}
  )
  who = subject(**unset.subject, kind: "ServiceAccount", name: "x")
  assert role_binding?(
    role_binding(**unset.role_binding, role_ref: ref, subjects: [who])
  )
  peer = network_policy_peer(
    **unset.network_policy_peer,
    pod_selector: label_selector(**unset.label_selector)
  )
  ingress = network_policy_ingress_rule(
    **unset.network_policy_ingress_rule,
    from: [peer]
  )
  spec = network_policy_spec(**unset.network_policy_spec, ingress: [ingress])
  assert network_policy?(network_policy(**unset.network_policy, spec:))
end

test "wire names restore the Kubernetes spelling"
  assert wire_names.match_labels == "matchLabels"
  assert wire_names.role_ref == "roleRef"
end
